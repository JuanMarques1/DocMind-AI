# Chave da OpenAI (opcional). Sem ela, o sistema usa o analisador mock automaticamente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chave para assinar os tokens JWT. Em produção, use um valor aleatório e secreto (32+ chars).
SECRET_KEY=dev-insecure-secret-change-me-please-32chars-min

# Headers HSTS (ative apenas em produção, com HTTPS).
HSTS_ENABLED=false
